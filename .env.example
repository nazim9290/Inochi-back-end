# Inochi Global Education — Backend
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=8080

# PostgreSQL — single connection string (preferred)
DATABASE_URL=postgres://user:password@localhost:5432/inochi

# OR set individual fields and leave DATABASE_URL empty:
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=inochi
# PG_PASSWORD=
# PG_DATABASE=inochi

# Set to "true" to allow self-signed SSL certificates (managed Postgres providers)
PG_SSL=false

# Sync the schema on startup (dev only — creates/updates tables to match models).
# In production use migrations instead.
DB_SYNC=true

# JWT auth — use a long random string (e.g. `openssl rand -hex 64`)
JWT_SECRET=replace_with_a_long_random_secret

# Cloudinary (for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP — used to email contact-form notifications and the admin inbox.
# Works with Gmail (use an App Password), Brevo/SendinBlue, SendGrid, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# `From` header on outgoing mail. Defaults to SMTP_USER if blank.
SMTP_FROM=Inochi Global Education <info@inochieducation.com>
# Where contact-form notifications are sent. Defaults to SMTP_USER if blank.
ADMIN_EMAIL=info@inochieducation.com

# Reply-To for school-outreach emails. All replies to outreach mail land here
# regardless of the SMTP From address. Defaults to inochiedu@gmail.com.
MAIL_REPLY_TO=inochiedu@gmail.com
# Delay (ms) between individual outreach sends to respect SMTP rate limits.
MAIL_SEND_DELAY_MS=250

# Public site URL (used by double-opt-in confirm links in newsletter emails,
# and as the host for IndexNow pings below).
PUBLIC_SITE_URL=https://inochieducation.com

# Admin site URL (used by the CORS allow-list — admin browser calls land here).
ADMIN_SITE_URL=https://admin.inochieducation.com

# Extra allowed CORS origins (comma-separated). The two URLs above are always
# included; add any staging / preview domains here. Leave blank in production.
CORS_ORIGINS=

# Set DEV_CORS=open ONLY in local development to bypass the CORS allow-list.
# DO NOT set this in production — it makes the API callable from any origin.
DEV_CORS=

# IndexNow — instantly notify Bing/Yandex/etc. when content is published.
# Public verification key (32-char hex). MUST match the frontend's INDEXNOW_KEY
# (the frontend serves it at /indexnow.txt). Generate once with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Leave blank to disable IndexNow pings entirely (publishing still works).
INDEXNOW_KEY=

# ────────────────────────────────────────────────────────────────────
# AI Blog (DeepSeek) — daily auto-publish of an SEO-optimised blog post
# ────────────────────────────────────────────────────────────────────
# Gate flag — set to "true" to enable the daily cron. Default is dormant.
AI_BLOG_ENABLED=false
# DeepSeek API key — required when AI_BLOG_ENABLED=true.
DEEPSEEK_API_KEY=
# DeepSeek model id (default: deepseek-chat).
DEEPSEEK_MODEL=deepseek-chat
# How many posts to auto-publish per day (default 2, clamped 1–6). This is a
# hard cap: the per-day success-count guard stops once this many posts exist
# for the day, no matter how many times the cron or "Generate now" fires.
AI_BLOG_PER_DAY=2
# Comma-separated local hours (0–23) to fire the daily runs, e.g. "9,18" for a
# morning + evening post. If blank, the scheduler spreads AI_BLOG_PER_DAY slots
# evenly starting at AI_BLOG_HOUR below. Each run fires at HH:17.
AI_BLOG_HOURS=9,18
# Fallback base hour (0–23) used only when AI_BLOG_HOURS is blank. Cron runs at
# HH:17 to avoid every-deployment-everywhere clustering on :00.
AI_BLOG_HOUR=9
# Optional admin User UUID to attribute AI posts to. If blank the
# scheduler picks the oldest admin in the DB.
AI_BLOG_AUTHOR_ID=
# AI cover image — uses Pollinations.ai (free Flux model, no key needed).
# Generated image is then uploaded to Cloudinary using the CLOUDINARY_*
# vars below, so we own the asset long-term. Nothing extra to configure;
# image generation auto-enables when Cloudinary creds are present.

# ────────────────────────────────────────────────────────────────────
# Facebook Lead Ads webhook (GET/POST /api/fb-leadgen)
# ────────────────────────────────────────────────────────────────────
# A secret you choose; paste the SAME value into the Meta App webhook setup as
# the "Verify Token" when subscribing the Page "leadgen" topic. Generate with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# The Page access token itself lives in Site Settings (fbPageAccessToken) — the
# same token that powers blog auto-post to Facebook.
FB_LEADGEN_VERIFY_TOKEN=
# Meta App Secret — when set, the webhook enforces X-Hub-Signature-256 on every
# POST (rejects anything not signed by Meta). Strongly recommended. Find it at
# developers.facebook.com → your App → Settings → Basic → App Secret.
FB_APP_SECRET=
# Optional Graph API version override (default v19.0).
FB_GRAPH_VERSION=v19.0
